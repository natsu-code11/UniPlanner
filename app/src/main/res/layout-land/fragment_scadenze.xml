<!-- ============================================================
     FILE: fragment_scadenze.xml (landscape)
     POSIZIONE: app/src/main/res/layout-land/
     SCOPO: Scadenze ottimizzata per tablet landscape.
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/background">

    <!-- colonna sinistra: controlli -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white">

        <Button
            android:id="@+id/btnTornaHome"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="← Home"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/parthenope_blue"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Le tue scadenze"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/parthenope_blue"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnAggiungiScadenza"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="+ Aggiungi"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/parthenope_gold" />

    </LinearLayout>

    <!-- colonna destra: lista scadenze -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvListaVuotaScadenze"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Nessuna scadenza aggiunta.&#10;Premi + per aggiungerne una!"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScadenze"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>