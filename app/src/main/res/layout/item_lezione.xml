<!-- ============================================================
     FILE: item_lezione.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Layout singola riga lezione con data.
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:layout_marginBottom="8dp">

    <View
        android:layout_width="4dp"
        android:layout_height="60dp"
        android:background="@color/parthenope_blue"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Matematica"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvAula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aula A1"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <!-- data lezione — visibile solo se presente -->
        <TextView
            android:id="@+id/tvDataLezione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21/09/2026"
            android:textSize="12sp"
            android:textColor="@color/parthenope_gold"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvOra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="09:00"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/parthenope_gold"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnElimina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="X"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:backgroundTint="#CC0000"
        android:padding="4dp" />

</LinearLayout>