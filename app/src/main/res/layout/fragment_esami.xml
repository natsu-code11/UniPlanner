<!-- ============================================================
     FILE: fragment_esami.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Schermata esami con contatore e media voti.
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <Button
        android:id="@+id/btnTornaHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Home"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/parthenope_blue"
        android:layout_margin="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I tuoi esami"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/parthenope_blue"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp" />

    <!-- contatore esami superati su totale -->
    <TextView
        android:id="@+id/tvContatore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Superati: 0 su 0"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp" />

    <!-- media voti -->
    <TextView
        android:id="@+id/tvMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Media: --"
        android:textSize="15sp"
        android:textColor="@color/parthenope_gold"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- messaggio lista vuota -->
    <TextView
        android:id="@+id/tvListaVuotaEsami"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Nessun esame aggiunto.&#10;Premi + per aggiungerne uno!"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEsami"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnAggiungiEsame"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="+ Aggiungi esame"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/parthenope_gold" />

</LinearLayout>