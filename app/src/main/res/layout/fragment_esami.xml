<!-- ============================================================
     FILE: fragment_esami.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Schermata esami con lista e media voti in cima.
     LEZIONE DI RIFERIMENTO: L10 (Layouts), L13 (RecyclerView)
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- bottone per tornare alla Home -->
    <Button
        android:id="@+id/btnTornaHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Home"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/parthenope_blue"
        android:layout_margin="8dp" />

    <!-- titolo sezione -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I tuoi esami"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/parthenope_blue"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp" />

    <!-- media voti -->
    <TextView
        android:id="@+id/tvMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Media: --"
        android:textSize="15sp"
        android:textColor="@color/parthenope_gold"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- lista esami -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEsami"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- bottone aggiungi esame -->
    <Button
        android:id="@+id/btnAggiungiEsame"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="+ Aggiungi esame"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/parthenope_gold" />

</LinearLayout>