<!-- ============================================================
     FILE: activity_aggiungi_esame.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Form per aggiungere o modificare un esame con DatePicker.
     LEZIONE DI RIFERIMENTO: L10 (Layouts & UI)
     ============================================================ -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitoloForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aggiungi esame"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/parthenope_blue"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome esame"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNomeEsame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. Matematica"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data appello"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <!-- bottone DatePicker per la data -->
        <Button
            android:id="@+id/btnSelezionaDataEsame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleziona data"
            android:textColor="@color/parthenope_blue"
            android:backgroundTint="@color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDataSelezionataEsame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nessuna data selezionata"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CFU"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCfuEsame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. 9"
            android:inputType="number"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voto (lascia vuoto se non ancora sostenuto)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etVotoEsame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. 28"
            android:inputType="number"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stato"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerStatoEsame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSalvaEsame"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Salva esame"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/parthenope_blue"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAnnullaEsame"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Annulla"
            android:textSize="16sp"
            android:textColor="@color/parthenope_blue"
            android:backgroundTint="@color/white" />

    </LinearLayout>
</ScrollView>