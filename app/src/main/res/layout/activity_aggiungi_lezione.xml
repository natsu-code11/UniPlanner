<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     FILE: activity_aggiungi_lezione.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Form per aggiungere una nuova lezione.
            Campi: materia, giorno, ora, aula.
     LEZIONE DI RIFERIMENTO: L10 (Layouts & UI)
     ============================================================ -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- titolo pagina -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aggiungi lezione"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/parthenope_blue"
            android:layout_marginBottom="24dp" />

        <!-- campo materia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Materia"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. Matematica"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- giorno della settimana -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giorno"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerGiorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- ora lezione -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ora"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etOra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. 09:00"
            android:inputType="time"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- aula -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aula"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. A1"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="32dp" />

        <!-- bottone salva -->
        <Button
            android:id="@+id/btnSalvaLezione"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Salva lezione"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/parthenope_blue"
            android:layout_marginBottom="12dp" />

        <!-- bottone annulla -->
        <Button
            android:id="@+id/btnAnnullaLezione"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Annulla"
            android:textSize="16sp"
            android:textColor="@color/parthenope_blue"
            android:backgroundTint="@color/white" />

    </LinearLayout>
</ScrollView>