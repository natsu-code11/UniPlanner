<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     FILE: activity_aggiungi_scadenza.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Form per aggiungere una nuova scadenza.
            Campi: titolo, tipo, data, priorità.
     LEZIONE DI RIFERIMENTO: L10 (Layouts & UI)
     ============================================================ -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- titolo pagina -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aggiungi scadenza"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/parthenope_blue"
            android:layout_marginBottom="24dp" />

        <!-- titolo scadenza -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titolo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTitoloScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. Pagamento tasse"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- tipo scadenza -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerTipoScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- data scadenza -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data entro cui completare"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etDataScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. 30/06/2026"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="20dp" />

        <!-- priorità -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Priorità"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerPrioritaScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="32dp" />

        <!-- bottone salva -->
        <Button
            android:id="@+id/btnSalvaScadenza"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Salva scadenza"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/parthenope_blue"
            android:layout_marginBottom="12dp" />

        <!-- bottone annulla -->
        <Button
            android:id="@+id/btnAnnullaScadenza"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Annulla"
            android:textSize="16sp"
            android:textColor="@color/parthenope_blue"
            android:backgroundTint="@color/white" />

    </LinearLayout>
</ScrollView>