<!-- ============================================================
     FILE: activity_aggiungi_scadenza.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Form per aggiungere o modificare una scadenza con DatePicker.
     LEZIONE DI RIFERIMENTO: L10 (Layouts & UI)
     ============================================================ -->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- titolo dinamico: "Aggiungi scadenza" o "Modifica scadenza" -->
        <TextView
            android:id="@+id/tvTitoloFormScadenza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aggiungi scadenza"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/parthenope_blue"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titolo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTitoloScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Es. Pagamento tasse"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/white"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerTipoScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data entro cui completare"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnSelezionaDataScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleziona data"
            android:textColor="@color/parthenope_blue"
            android:backgroundTint="@color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDataSelezionataScadenza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nessuna data selezionata"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Priorità"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerPrioritaScadenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSalvaScadenza"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Salva scadenza"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/parthenope_blue"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAnnullaScadenza"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Annulla"
            android:textSize="16sp"
            android:textColor="@color/parthenope_blue"
            android:backgroundTint="@color/white" />

    </LinearLayout>
</ScrollView>