<!-- ============================================================
     FILE: fragment_scadenze.xml
     POSIZIONE: app/src/main/res/layout/
     SCOPO: Schermata scadenze con lista ordinata per data.
            Mostra messaggio quando lista è vuota.
     LEZIONE DI RIFERIMENTO: L10 (Layouts), L13 (RecyclerView)
     ============================================================ -->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <Button
        android:id="@+id/btnTornaHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Home"
        android:textSize="13sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/parthenope_blue"
        android:layout_margin="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Le tue scadenze"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/parthenope_blue"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp" />

    <!-- messaggio lista vuota -->
    <TextView
        android:id="@+id/tvListaVuotaScadenze"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Nessuna scadenza aggiunta.&#10;Premi + per aggiungerne una!"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvScadenze"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnAggiungiScadenza"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="+ Aggiungi scadenza"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="@color/parthenope_gold" />

</LinearLayout>